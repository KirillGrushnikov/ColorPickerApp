<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ColorPickerApp"
        xmlns:vm="clr-namespace:ColorPickerApp.ViewModels"
        x:Class="ColorPickerApp.Views.HotkeyDialogView"
        x:DataType="vm:HotkeyDialogViewModel"
        Title="{local:Tr hk_title}"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        RequestedThemeVariant="Dark">

    <Design.DataContext>
        <vm:HotkeyDialogViewModel/>
    </Design.DataContext>

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{local:Tr hk_prompt}"
                   HorizontalAlignment="Center"
                   FontWeight="Bold"/>
        <Border Background="#484848"
                CornerRadius="5"
                Padding="10"
                Margin="0,6">
            <TextBlock Text="{Binding CurrentHotkey}"
                       FontSize="18"
                       FontFamily="Consolas, Courier New"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"/>
        </Border>
        <TextBlock Text="{Binding ErrorText}"
                   IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="#FF8A65"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Content="{local:Tr hk_confirm}" Command="{Binding Confirm}" Width="120" HorizontalContentAlignment="Center"/>
            <Button Content="{local:Tr hk_cancel}" Command="{Binding Cancel}" Width="120" HorizontalContentAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{local:Tr hk_hint}"
                   FontSize="10"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
