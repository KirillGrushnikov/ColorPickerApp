<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ColorPickerApp"
             x:Class="ColorPickerApp.App"
             xmlns:vm="using:ColorPickerApp.ViewModels"
             RequestedThemeVariant="Dark"
             x:DataType="vm:MainWindowViewModel">

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/avalonia-logo.ico"
                ToolTipText="{Binding TrayToolTip}"
                Command="{Binding ShowWindowCommand}">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="{local:Tr tray_open}" Command="{Binding ShowWindowCommand}" Gesture="{Binding OpenWindowKeyGesture}"/>
            <NativeMenuItem Header="{local:Tr tray_picker}" Command="{Binding ShowEyedropper}" Gesture="{Binding PickerKeyGesture}"/>
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{local:Tr tray_quit}" Command="{Binding QuitCommand}"/>
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

  <Application.Resources>
    <!-- Шрифт по умолчанию для всех контролов Fluent -->
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
  </Application.Resources>

  <Application.Styles>
  <!-- Кнопки -->
    <Style Selector="Button">
        <Setter Property="Background" Value="#3D3D3D"/>
        <Setter Property="Foreground" Value="#CCCCCC"/>
        <Setter Property="BorderBrush" Value="#555555"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#4A4A4A"/>
        <Setter Property="BorderBrush" Value="#666666"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#2A2A2A"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="#2A2A2A"/>
        <Setter Property="TextElement.Foreground" Value="#666666"/>
    </Style>
    <Style Selector="ScrollViewer">
		<Setter Property="Background" Value="Transparent" />
	</Style>
    <Style Selector="ScrollViewer /template/ ScrollBar /template/ Thumb">
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}" CornerRadius="20" ClipToBounds="True"/>
			</ControlTemplate>
		</Setter>
	</Style>
    <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ Rectangle#TrackRect">
		<Setter Property="Fill" Value="Transparent"/>
	</Style>
	<Style Selector="ScrollViewer /template/ ScrollBar:horizontal /template/ Rectangle#TrackRect">
		<Setter Property="Fill" Value="Transparent"/>
	</Style>
    <FluentTheme />
  </Application.Styles>
</Application>
