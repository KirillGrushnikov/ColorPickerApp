<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ColorPickerApp.App"
             xmlns:vm="using:ColorPickerApp.ViewModels"
             RequestedThemeVariant="Dark"
             x:DataType="vm:MainWindowViewModel">

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/avalonia-logo.ico"
                ToolTipText="{Binding TrayToolTip}"
                Command="{Binding ShowWindowCommand}">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Открыть" Command="{Binding ShowWindowCommand}" Gesture="{Binding OpenWindowKeyGesture}"/>
            <NativeMenuItem Header="Пипетка" Command="{Binding ShowEyedropper}" Gesture="{Binding PickerKeyGesture}"/>
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Выход" Command="{Binding QuitCommand}"/>
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

  <Application.Resources>
    <!-- Шрифт по умолчанию для всех контролов Fluent -->
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- Тема ColorPicker подключена в SettingsView.axaml: она грузится только при первом открытии настроек -->
  </Application.Styles>
</Application>
